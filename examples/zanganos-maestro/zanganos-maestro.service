[Unit]
Description=AI Maestro local para ZanganOS
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/ai-maestro
Environment=HOSTNAME=127.0.0.1
Environment=PORT=23000
ExecStart=/usr/bin/yarn dev
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
