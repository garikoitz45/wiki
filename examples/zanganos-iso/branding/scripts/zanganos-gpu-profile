#!/usr/bin/env bash
set -Eeuo pipefail

install -d /etc/zanganos/gaming
profile=generic
if command -v nvidia-smi >/dev/null 2>&1; then
  profile=nvidia-rtx2080-super
elif lspci 2>/dev/null | grep -Eqi 'Radeon RX 580|AMD/ATI.*Polaris'; then
  profile=amd-rx580
fi
printf '%s\n' "$profile" >/etc/zanganos/gaming/detected-profile
printf 'ZanganOS GPU profile: %s\n' "$profile"
